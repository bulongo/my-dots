#!/usr/bin/env bash

set -e

WALLPAPER_DIR="$HOME/Pictures/wallpapers"

IMAGE=$(find "$WALLPAPER_DIR" -type f \
    \( -iname '*.jpg' \
    -o -iname '*.jpeg' \
    -o -iname '*.png' \
    -o -iname '*.webp' \
    -o -iname '*.gif' \) \
    -printf '%f\n' |
    sort |
    fuzzel --dmenu --prompt "Wallpaper > ")

[[ -z "$IMAGE" ]] && exit 0

"$HOME/.local/bin/wallpaper" "$WALLPAPER_DIR/$IMAGE"


